{
  "name": "url-to-figma",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build":            "pnpm -r build",
    "build:shared":     "pnpm --filter @url-to-figma/shared build",
    "typecheck":        "pnpm -r typecheck",

    "capture":          "pnpm --filter @url-to-figma/capture capture",
    "transform":        "pnpm --filter @url-to-figma/transformer transform",

    "pipeline":         "node scripts/pipeline.mjs",

    "serve:fixtures":   "node scripts/serve-fixtures.mjs",
    "serve:ir":         "node scripts/serve-ir.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "serve": "^14",
    "typescript": "^5.4.0"
  }
}
